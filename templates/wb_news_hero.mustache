{{!
    @template local_wb_news/wb_news_hero

    Single hero image with a text box on the right side. Renders only the
    first (active) news item of the instance, reusing the slider data fields.

    Classes required for JS:
    * none

    Example context (json):
    {
        "instanceid": 7,
        "editmode": false,
        "news": [
            {
                "slideactive": true,
                "lightmode": true,
                "cssclasses": "bg-dark p-5",
                "tags": ["Update", "Feature", "Release"],
                "headline": "Moodle 5.1: Now with AI Integration",
                "description": "<p>Seamless AI tools for grading and feedback.</p>",
                "btntext": "Read More",
                "btnlink": "https://moodle.example.com/news",
                "btnlinktarget": "_blank",
                "btnlinkrel": "noopener",
                "bgimage": "https://moodle.example.com/images/hero-bg.jpg",
                "headerimage": "/local/wb_news/img/wb.jpg",
                "bgimagetext": "AI interface background",
                "headerimagetext": "Header Image Text",
                "imagecaption": "Screenshot of the new AI grading interface"
            }
        ]
    }
}}

<div id="wb_news_hero-{{instanceid}}" class="wb_news wb_news_hero" data-id="{{instanceid}}">
    {{#editmode}}
        {{> local_wb_news/edit}}
    {{/editmode}}
    {{#news}}
    {{#slideactive}}
    <div class="wb_news_hero_item{{#lightmode}} wb_news-light{{/lightmode}}">
        <div class="image-container w-100">
            <img src="{{bgimage}}{{headerimage}}" class="img-fluid w-100" aria-label="{{bgimagetext}}{{headerimagetext}}" alt="{{bgimagetext}}{{headerimagetext}}">
            {{#imagecaption}}
            <div class="image-caption">{{imagecaption}}</div>
            {{/imagecaption}}
        </div>
        <div class="card wb_news_hero_box{{#lightmode}} text-light{{/lightmode}}{{#cssclasses}} {{cssclasses}}{{/cssclasses}}">
            <div class="card-body">
                {{#tags}} <span class="badge badge-success">{{.}}</span>{{/tags}}
                {{#headline}}
                    <h1>{{{headline}}}</h1>
                {{/headline}}
                {{{description}}}
                {{#btntext}}
                <a href="{{btnlink}}" class="btn btn-primary mt-4" {{#btnlinktarget}}target="{{.}}"{{/btnlinktarget}} {{#btnlinkrel}}rel="{{.}}"{{/btnlinkrel}}>{{btntext}}</a>
                {{/btntext}}
                {{#editmode}}
                {{> local_wb_news/editsinglenews}}
                {{/editmode}}
            </div>
        </div>
    </div>
    {{/slideactive}}
    {{/news}}
</div>

{{#js}}
    require(['local_wb_news/editnews'], function(fn) {
        fn.init({{instanceid}});
    });
{{/js}}
